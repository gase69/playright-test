{
  "name": "playright-test",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:trace": "playwright test --trace on",
    "trace": "playwright show-trace",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "open": "playwright open",
    "estimate": "tsx scripts/generate-aws-rds-estimate.ts",
    "estimate:py": "uv run --directory python generate-aws-rds-estimate-py",
    "check:py": "uv run --directory python ruff check . && uv run --directory python pyright",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "audit": "npm audit",
    "sec-check": "npm run check && npm run lint && npm run audit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/mcp": "^0.0.78",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-security": "^4.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
